# GeoSSL Backend Environment Configuration

# Data Provider Configuration
# Options: 'gee' (default: attempts GEE first, falls back to local GeoTIFF) or 'local' (forces local GeoTIFF only)
GEOSSL_PROVIDER_MODE=gee
GEE_ENABLED=true

# Google Earth Engine Configuration
# Option 1: Google Cloud Project ID (Recommended for modern Earth Engine API)
EE_PROJECT=glossy-champion-503414-e9

# Option 2: Service Account Authentication (Optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# EE_SERVICE_ACCOUNT=your-service-account@your-gcp-project.iam.gserviceaccount.com
# EE_PRIVATE_KEY_FILE=/path/to/service-account-key.json

# Pluggable Analysis Engine ('prototype' for deterministic baseline, 'mae_vit' for future model)
ANALYSIS_ENGINE_TYPE=prototype

